# 04-wifi.rsc — WiFi SSIDs mapped to segments
# Generated by lankit — do not edit directly
#
# Strategy:
#   - Master interfaces hidden and renamed to prevent direct association
#     (MikroTik: changing PVID on masters corrupts internal WiFi state)
#   - All SSIDs are virtual APs on top of the masters
#   - Same SSID + passphrase on both bands = seamless band-steering

# ── Remove previously managed entries (idempotent re-apply) ─────────────────
{% if include_globals %}
:foreach i in=[/interface bridge port find where comment~"^lankit:wifi:"] do={ /interface bridge port remove $i }
:foreach i in=[/interface wifi find where comment~"^lankit:wifi:"] do={ /interface wifi remove $i }
:foreach i in=[/interface wifi security find where comment~"^lankit:wifi:"] do={ /interface wifi security remove $i }
{% else %}
{% for name in segments %}
:foreach i in=[/interface bridge port find where comment~"^lankit:wifi:{{ name }}:"] do={ /interface bridge port remove $i }
:foreach i in=[/interface wifi find where comment~"^lankit:wifi:{{ name }}:"] do={ /interface wifi remove $i }
:foreach i in=[/interface wifi security find where comment~"^lankit:wifi:{{ name }}:"] do={ /interface wifi security remove $i }
{% endfor %}
{% endif %}

{% set bands = namespace(g5=false, g2=false) %}
{% for seg in segments.values() if seg.has_wifi %}
{% if '5ghz' in seg.wifi_bands %}{% set bands.g5 = true %}{% endif %}
{% if '2ghz' in seg.wifi_bands %}{% set bands.g2 = true %}{% endif %}
{% endfor %}
{% set uses_5g = bands.g5 %}
{% set uses_2g = bands.g2 %}
{% if include_globals and (uses_5g or uses_2g) %}
# ── Hide master interfaces ───────────────────────────────────────────────────
# Only for bands some segment uses: a router without that radio (or with no
# radios at all) would otherwise fail `set` with "no such item" and halt the
# import (#62). Radio names are still assumed: wifi1 = 5 GHz, wifi2 = 2.4 GHz.
/interface wifi
{% if uses_5g %}
set wifi1 \
    configuration.ssid="_master-5g-noconnect" \
    configuration.hide-ssid=yes
{% endif %}
{% if uses_2g %}
set wifi2 \
    configuration.ssid="_master-2g-noconnect" \
    configuration.hide-ssid=yes
{% endif %}
{% endif %}

# ── Security profiles ────────────────────────────────────────────────────────
{% for name, seg in segments.items() %}
{% if seg.has_wifi %}
/interface wifi security
add name=sec-{{ name }} \
    authentication-types=wpa2-psk{% if '5ghz' in seg.wifi_bands %},wpa3-psk{% endif %} \
    passphrase="{{ wifi_passphrases[name] }}" \
    comment="lankit:wifi:{{ name }}:security"
{% endif %}
{% endfor %}

# ── Virtual APs ──────────────────────────────────────────────────────────────
{% for name, seg in segments.items() %}
{% if seg.has_wifi %}
{% if '5ghz' in seg.wifi_bands %}
/interface wifi
add name=wifi-{{ name }}-5g \
    master-interface=wifi1 \
    configuration.ssid="{{ seg.ssid }}" \
    configuration.hide-ssid={{ 'yes' if seg.ssid_hidden else 'no' }} \
    security=sec-{{ name }} \
    disabled=no \
    comment="lankit:wifi:{{ name }}:ap-5g"
{% endif %}
{% if '2ghz' in seg.wifi_bands %}
/interface wifi
add name=wifi-{{ name }}-2g \
    master-interface=wifi2 \
    configuration.ssid="{{ seg.ssid }}" \
    configuration.hide-ssid={{ 'yes' if seg.ssid_hidden else 'no' }} \
    security=sec-{{ name }} \
    disabled=no \
    comment="lankit:wifi:{{ name }}:ap-2g"
{% endif %}
{% endif %}
{% endfor %}

# ── Bridge port assignments (PVID maps each AP to its VLAN) ─────────────────
{% for name, seg in segments.items() %}
{% if seg.has_wifi %}
{% if '5ghz' in seg.wifi_bands %}
/interface bridge port
add bridge=bridge \
    interface=wifi-{{ name }}-5g \
    pvid={{ seg.vlan_id }} \
    comment="lankit:wifi:{{ name }}:bridge-5g"
{% endif %}
{% if '2ghz' in seg.wifi_bands %}
/interface bridge port
add bridge=bridge \
    interface=wifi-{{ name }}-2g \
    pvid={{ seg.vlan_id }} \
    comment="lankit:wifi:{{ name }}:bridge-2g"
{% endif %}
{% endif %}
{% endfor %}

# ── Untagged VLAN membership for virtual APs ─────────────────────────────────
{% for name, seg in segments.items() %}
{% if seg.has_wifi %}
/interface bridge vlan
set [find where vlan-ids={{ seg.vlan_id }}] \
    untagged={% if '5ghz' in seg.wifi_bands %}wifi-{{ name }}-5g{% endif %}{% if seg.wifi_bands | length == 2 %},{% endif %}{% if '2ghz' in seg.wifi_bands %}wifi-{{ name }}-2g{% endif %}

{% endif %}
{% endfor %}
